# Banana Navy — Environment variables
# Copy to .env (never commit). Production values go into Cloudflare Pages → Variables.

# ============ Build ============
# Production URL. Used to generate canonical URLs, sitemap, llms.txt, OG meta.
PUBLIC_SITE_URL=https://banana-navy.com

# ============ System 9 — Cloudflare Pages Function (contact form) ============
# Email provider for /api/contact notifications. Resend.com works at the free tier.
RESEND_API_KEY=
NOTIFY_TO=hello@banana-navy.com
NOTIFY_FROM=site@banana-navy.com

# Optional: mirror every contact submission to your CRM via webhook.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# ============ Systems 6 + 7 — CRM lead recovery & operations ============
# CRM_PROVIDER: ghl | hubspot | notion | pipedrive | salesforce
CRM_PROVIDER=
CRM_API_KEY=
CRM_LOCATION_ID=                       # GHL only

# ============ Anthropic API ============
# Used by:
#  - scripts/lead-scanner.mjs (Playbook System 6)
#  - functions/api/agents/team.js  (internal /team/ chat runtime, Sonnet 4.6)
#  - functions/api/agents/demo.js  (public /demo-agents/ runtime, Haiku 4.5)
ANTHROPIC_API_KEY=

# ============ Banana Navy Team Agents (System 8 web runtime) ============
# Shared password for /team/* (HTTP Basic). Pick a strong random string.
# When the team grows past 3-5 people, switch to Cloudflare Access (free,
# supports SSO + per-user policies).
BANANA_NAVY_TEAM_PASSWORD=

# ============ System 4 — YouTube Autopilot (deferred until IG/YT live) ============
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_USER_ID=
# INSTAGRAM_LONG_LIVED_TOKEN=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=

# ============ System 10 — Twilio messaging (deferred until account) ============
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=+32...
# TWILIO_SENDER_ID=BANANA-NAVY
# TWILIO_VOICE_WEBHOOK=https://banana-navy.com/api/voice/incoming
