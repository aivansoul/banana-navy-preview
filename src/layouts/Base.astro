---
import "~/styles/base.css";
import "~/styles/banana-navy.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import SchemaJsonLd from "~/components/SchemaJsonLd.astro";
import DesignStudio from "~/components/DesignStudio.astro";
import {
  SITE,
  LOCALE_TAG,
  LOCALES,
  DEFAULT_LOCALE,
  absoluteUrl,
  localizedPath,
  stripLocale,
  asset,
  type Locale,
} from "~/lib/site";
import { t } from "~/lib/i18n";
import { organization, webPage } from "~/lib/schema";

export interface Props {
  /** ISO locale of this page. */
  locale?: Locale;
  /** Page title — used as <title> and og:title. */
  title: string;
  /** Meta description + og:description. Keep under ~160 chars. */
  description: string;
  /** Optional OG image override (absolute or root-relative). */
  ogImage?: string;
  /** Additional JSON-LD blocks beyond the auto WebPage + Organization. */
  schema?: unknown[];
  /** Set to true on legal / draft pages to keep them out of search. */
  noindex?: boolean;
  /** Body class hook for page-specific styles. */
  bodyClass?: string;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  ogImage,
  schema = [],
  noindex = false,
  // Default every page to the editorial light theme so the nav, links and
  // logo always render in dark ink on the cream canvas. Pages that need a
  // dark theme can explicitly pass bodyClass="" or another class.
  bodyClass = "press-light",
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
const canonicalUrl = absoluteUrl(canonicalPath);
const localeTag = LOCALE_TAG[locale];

// hreflang pairs: derive the route key from the current URL, then build all locale variants.
const routeKey = stripLocale(canonicalPath);
const hreflangs = LOCALES.map((loc) => ({
  locale: loc,
  tag: LOCALE_TAG[loc],
  href: absoluteUrl(localizedPath(loc, routeKey)),
}));

const ogImg = absoluteUrl(ogImage || SITE.defaultOgImage);

const schemaBlocks = [
  organization(),
  webPage({ url: canonicalUrl, title, description, locale }),
  ...schema,
];

const i = t(locale);
---
<!doctype html>
<html lang={localeTag} data-theme={bodyClass.includes("press-light") ? "light" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F4F4F6" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && (
      <meta
        name="robots"
        content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
      />
    )}

    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.tag} href={h.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(localizedPath(DEFAULT_LOCALE, routeKey))}
    />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:locale" content={localeTag.replace("-", "_")} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_TAG[l].replace("-", "_")} />
    ))}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    {/* GEO — Charleroi, Belgium */}
    <meta name="geo.region" content="BE-WHT" />
    <meta name="geo.placename" content={SITE.address.city} />
    <meta
      name="geo.position"
      content={`${SITE.address.latitude};${SITE.address.longitude}`}
    />
    <meta
      name="ICBM"
      content={`${SITE.address.latitude}, ${SITE.address.longitude}`}
    />

    {/* Markdown mirror — AI tools can fetch the clean version */}
    <link
      rel="alternate"
      type="text/markdown"
      href={`${canonicalUrl}index.md`}
      title="Markdown mirror"
    />

    {/* Sitemap */}
    <link rel="sitemap" type="application/xml" href={asset("/sitemap-index.xml")} />

    {/* Favicon */}
    <link
      rel="icon"
      type="image/svg+xml"
      href={
        "data:image/svg+xml," +
        encodeURIComponent(
          `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23000'/><circle cx='16' cy='16' r='8' fill='%23fcff61'/><path d='M14 12 L20 14 L18 20 L12 18 Z' fill='%23000'/></svg>`,
        )
      }
    />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Urbanist:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    {/* Switzer (Fontshare) — used by the cinematic CTA */}
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700,800,900&display=swap"
      rel="stylesheet"
    />

    <SchemaJsonLd data={schemaBlocks} />
  </head>
  <body class={bodyClass} data-theme={bodyClass.includes("press-light") ? "light" : undefined}>
    <a href="#main" class="skip-link">{i.common.skip_to_content}</a>
    <Nav locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <DesignStudio />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 8px;
    background: var(--accent);
    color: #0a0a0a;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    z-index: 9999;
  }
  .skip-link:focus {
    left: 8px;
  }
</style>
