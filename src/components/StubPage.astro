---
import { type Locale, localizedPath } from "~/lib/site";
import { t } from "~/lib/i18n";

interface Props {
  locale: Locale;
  eyebrow: string;
  heading: string;
  intro: string;
  /** Optional sections of richer copy (string paragraphs). */
  body?: string[];
  /** Optional next-step CTA. */
  cta?: { label: string; href: string };
  /** Phase note shown discreetly to flag this page is awaiting full content. */
  phaseNote?: string;
}
const { locale, eyebrow, heading, intro, body = [], cta, phaseNote } = Astro.props;
const i = t(locale);
const r = i.routes;
---
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="eyebrow mono"><span class="dot"></span>{eyebrow}</div>
        <h1 class="display h1" style="margin-top: 24px;">{heading}</h1>
        <p class="body-l" style="color: var(--fg-60); max-width: 60ch; margin-top: 24px;">
          {intro}
        </p>
      </div>
    </div>

    {body.length > 0 && (
      <div class="stub-body">
        {body.map((p) => <p>{p}</p>)}
      </div>
    )}

    {cta && (
      <div style="margin-top: 48px;">
        <a href={cta.href} class="btn-yellow">{cta.label}</a>
      </div>
    )}

    {phaseNote && (
      <p class="phase-note mono">{phaseNote}</p>
    )}

    <div style="margin-top: 64px; display: flex; gap: 24px; flex-wrap: wrap;">
      <a href={localizedPath(locale, r.home)} class="body-s">← {locale === "fr" ? "Retour à l'accueil" : "Terug naar home"}</a>
      <a href={localizedPath(locale, r.contact)} class="body-s">{i.nav.contact} →</a>
    </div>
  </div>
</section>

<style>
  .stub-body {
    max-width: 70ch;
    margin-top: 40px;
    display: grid;
    gap: 20px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg-60);
  }
  .stub-body p {
    color: var(--fg-60);
  }
  .phase-note {
    margin-top: 48px;
    padding: 12px 16px;
    border: 1px dashed var(--fg-20);
    color: var(--fg-40);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-block;
  }
</style>
