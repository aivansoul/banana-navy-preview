---
import { SITE, type Locale, localizedPath, asset } from "~/lib/site";
import { t } from "~/lib/i18n";
import { SERVICE_CATEGORIES, LOCATIONS } from "~/lib/content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const i = t(locale);
const r = i.routes;
const link = (path: string) => localizedPath(locale, path);
const year = new Date().getFullYear();
---
<footer class="footer-bn" id="footer">
  <div class="footer-bn-inner">
    <div class="footer-bn-top footer-bn-top-wide">
      <div class="footer-brand-col">
        <a href={link(r.home)} class="footer-brand" aria-label="Banana Navy">
          <img
            src={asset("/banana-navy-logo.svg")}
            width="110"
            height="84"
            alt="Banana Navy"
            class="bn-logo bn-logo-lg"
          />
        </a>
        <p class="footer-tag">{i.footer.tagline}</p>
      </div>

      {SERVICE_CATEGORIES.map((cat) => (
        <div class="footer-col">
          <h5><a href={link(`/${cat.slug}/`)}>{cat.head}</a></h5>
          <ul>
            {cat.leaves.map((leaf) => (
              <li>
                <a href={link(`/${cat.slug}/${leaf.slug}/`)}>{leaf.name[locale]}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bn-top footer-bn-secondary">
      <div class="footer-col footer-col-wide">
        <h5><a href={link((i.routes as any).locations || "/locations/")}>{locale === "fr" ? "Villes" : "Steden"}</a></h5>
        <ul class="footer-cities">
          {LOCATIONS.map((c) => (
            <li>
              <a href={link(`/locations/${c.slug}/`)}>{c.name[locale]}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>{i.footer.sections.company}</h5>
        <ul>
          <li><a href={link(r.approche)}>{i.nav.approche}</a></li>
          <li><a href={link(r.equipe)}>{i.nav.equipe}</a></li>
          <li><a href={link(r.lab)}>{i.nav.lab}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>{i.footer.sections.resources}</h5>
        <ul>
          <li><a href={link(r.realisations)}>{i.nav.realisations}</a></li>
          <li><a href={link(r.faq)}>FAQ</a></li>
          <li><a href={link(r.contact)}>{i.nav.contact}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>{i.footer.sections.legal}</h5>
        <ul>
          <li><a href={link(r.mentions)}>{i.footer.legal.mentions}</a></li>
          <li><a href={link(r.privacy)}>{i.footer.legal.privacy}</a></li>
          <li><a href={link(r.cgv)}>{locale === "fr" ? "CGV" : "AV"}</a></li>
          <li>
            <a href={locale === "fr" ? "/llms.txt" : "/nl/llms.txt"}>
              {i.footer.legal.llms}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bn-meta">
      <span>
        {SITE.legalName} · {SITE.address.street} · {SITE.address.postalCode}{" "}
        {SITE.address.city}, {SITE.address.countryName}
      </span>
      <span>
        TVA {SITE.vatNumber} ·{" "}
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            `${SITE.address.street}, ${SITE.address.postalCode} ${SITE.address.city}`,
          )}`}
          rel="noopener"
        >
          Google Maps →
        </a>
      </span>
      <span>© {year} {SITE.brandName} · {i.footer.rights}</span>
    </div>
  </div>
</footer>

<style>
  /* New wide footer: brand + 5 service category columns on one row */
  .footer-bn-top-wide {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: 32px;
    align-items: start;
  }
  .footer-brand-col {
    grid-column: 1;
  }
  .footer-bn-secondary {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 32px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--fg-10);
  }
  .footer-cities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px 16px;
  }
  .footer-cities li { display: block; }
  .footer-cities a {
    font-size: 12px;
    color: var(--fg-60);
    display: block;
    padding: 3px 0;
    transition: color 0.15s ease;
  }
  .footer-cities a:hover { color: var(--accent); }
  @media (max-width: 1100px) {
    .footer-bn-top-wide {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer-brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .footer-bn-top-wide,
    .footer-bn-secondary {
      grid-template-columns: 1fr 1fr;
    }
    .footer-col-wide { grid-column: 1 / -1; }
  }
  .footer-col h5 a {
    color: inherit;
    transition: color 0.15s ease;
  }
  .footer-col h5 a:hover {
    color: var(--accent);
  }
</style>
