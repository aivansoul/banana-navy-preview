---
/**
 * ImageAccordion.astro — generic horizontal image accordion.
 *
 * Same interaction model as LayersAccordion: one card expanded at a time,
 * collapsed cards show a rotated vertical title with a grayscale image
 * underneath, hovering / tapping swaps the active card.
 *
 * Used on the home page for:
 *   • "Une couche IA opérationnelle" (5 domaines: communication, crm, orchestration, visibility, infrastructure)
 *   • "Pas de boîte noire" (3 piliers: souveraineté, modularité, éthique)
 */
export interface AccordionItem {
  /** Stable key (used to identify the card). */
  key: string;
  /** "01" / "02" — editorial layer number. */
  num: string;
  /** Headline shown both collapsed (rotated) and expanded. */
  name: string;
  /** Body copy shown when expanded. */
  desc: string;
  /** Optional click-through link. */
  href?: string;
  /** Unsplash / asset URL for the card background image. */
  image: string;
  /** If true, this card is highlighted (accent number, default active). */
  keystone?: boolean;
  /** Custom CTA label for this card (defaults to "Voir"). */
  cta?: string;
}

interface Props {
  items: AccordionItem[];
  /** Index of the card that should be active on first paint.
   *  Defaults to the last keystone, then the last card. */
  defaultActiveIndex?: number;
  /** Label for the CTA chip when href is set. */
  defaultCta?: string;
  /** Render as a div (no link wrapper) when items have no href. */
  hrefless?: boolean;
}

const {
  items,
  defaultActiveIndex,
  defaultCta = "Voir",
  hrefless = false,
} = Astro.props;

// Pre-compute the starting active index server-side (used as a fallback;
// the inline script overrides on hydrate so the user can interact).
const computedDefault =
  typeof defaultActiveIndex === "number"
    ? defaultActiveIndex
    : items.findIndex((it) => it.keystone) !== -1
      ? items.map((it, i) => (it.keystone ? i : -1)).filter((i) => i !== -1).pop()!
      : items.length - 1;
---
<div class="image-accordion" data-image-accordion data-initial={String(computedDefault)}>
  {items.map((it, i) => {
    const Tag = hrefless || !it.href ? "div" : "a";
    const linkProps =
      Tag === "a" ? { href: it.href, "aria-label": `${it.num} — ${it.name}` } : {};
    return (
      <Tag
        class:list={["ia-card", it.keystone && "is-keystone", i === computedDefault && "is-active"]}
        data-ia-card
        data-index={i}
        {...linkProps}
      >
        <img
          class="ia-card-img"
          src={it.image}
          alt=""
          loading="lazy"
          aria-hidden="true"
        />
        <span class="ia-card-tint" aria-hidden="true"></span>

        <span class="ia-card-num">{it.num}</span>

        <span class="ia-card-title">{it.name}</span>

        <span class="ia-card-desc">{it.desc}</span>

        {it.href && (
          <span class="ia-card-cta" aria-hidden="true">
            {it.cta ?? defaultCta} <span class="ia-card-cta-arrow">→</span>
          </span>
        )}
      </Tag>
    );
  })}
</div>

<style>
  /* ============================================================
     GENERIC HORIZONTAL IMAGE ACCORDION
     ============================================================ */
  .image-accordion {
    display: flex;
    gap: 14px;
    width: 100%;
    height: clamp(420px, 56vh, 540px);
    margin-top: 56px;
  }

  .ia-card {
    position: relative;
    flex: 0 0 64px;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    transition: flex-basis 0.7s cubic-bezier(0.45, 0, 0.2, 1);
    background: #1a1a1a;
    isolation: isolate;
  }
  .ia-card.is-active {
    flex-basis: 460px;
  }

  /* Background image + tint */
  .ia-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08) brightness(0.85);
    transition: filter 0.7s ease, transform 0.7s ease;
    z-index: 0;
  }
  .ia-card.is-active .ia-card-img {
    filter: grayscale(0.15) contrast(1.04) brightness(0.96);
    transform: scale(1.04);
  }
  .ia-card-tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.35) 55%, rgba(0,0,0,0.75) 100%);
    z-index: 1;
    transition: background 0.5s ease;
  }
  .ia-card.is-active .ia-card-tint {
    background:
      linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.25) 50%, rgba(0,0,0,0.78) 100%);
  }

  /* Editorial number — always visible top-left */
  .ia-card-num {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;
    font-family: "Switzer", "Inter Tight", system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.88);
  }
  .ia-card.is-keystone .ia-card-num {
    color: var(--accent, #fcff61);
  }

  /* Title — rotated vertically when collapsed, horizontal when active */
  .ia-card-title {
    position: absolute;
    bottom: 88px;
    left: 50%;
    z-index: 3;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.4vw, 20px);
    letter-spacing: -0.01em;
    color: #fff;
    white-space: nowrap;
    transform-origin: left bottom;
    transform: translateX(-50%) rotate(-90deg) translateY(50%);
    transition:
      transform 0.55s cubic-bezier(0.45, 0, 0.2, 1),
      bottom 0.55s cubic-bezier(0.45, 0, 0.2, 1),
      left 0.55s cubic-bezier(0.45, 0, 0.2, 1),
      font-size 0.55s ease;
  }
  .ia-card.is-active .ia-card-title {
    bottom: clamp(60px, 8vh, 80px);
    left: 28px;
    transform: translateX(0) rotate(0);
    font-size: clamp(22px, 2.2vw, 32px);
  }

  /* Description — visible when active only */
  .ia-card-desc {
    position: absolute;
    bottom: 24px;
    left: 28px;
    right: 96px;
    z-index: 3;
    font-family: "Switzer", "Inter Tight", system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease 0.15s, transform 0.45s ease 0.15s;
    pointer-events: none;
  }
  .ia-card.is-active .ia-card-desc {
    opacity: 1;
    transform: translateY(0);
  }

  /* CTA chip — bottom-right when active */
  .ia-card-cta {
    position: absolute;
    bottom: 24px;
    right: 24px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: "Switzer", "Inter Tight", system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease 0.2s, transform 0.45s ease 0.2s, background 0.2s ease;
  }
  .ia-card.is-active .ia-card-cta {
    opacity: 1;
    transform: translateY(0);
  }
  .ia-card.is-active:hover .ia-card-cta {
    background: var(--accent, #fcff61);
    color: #0a0a0a;
    border-color: var(--accent, #fcff61);
  }
  .ia-card-cta-arrow {
    transition: transform 0.25s ease;
  }
  .ia-card.is-active:hover .ia-card-cta-arrow {
    transform: translateX(3px);
  }

  /* ----- Responsive ----- */
  @media (max-width: 900px) {
    .image-accordion {
      flex-direction: column;
      height: auto;
      gap: 10px;
    }
    .ia-card {
      flex: 0 0 80px;
      width: 100%;
      height: 80px;
      border-radius: 14px;
    }
    .ia-card.is-active {
      flex-basis: 320px;
      height: 320px;
    }
    .ia-card-title {
      bottom: 50%;
      left: 24px;
      transform: translateY(50%) rotate(0);
      font-size: 15px;
    }
    .ia-card.is-active .ia-card-title {
      bottom: 72px;
      left: 24px;
      transform: none;
      font-size: 22px;
    }
    .ia-card-desc {
      bottom: 24px;
      left: 24px;
      right: 24px;
      font-size: 12.5px;
    }
    .ia-card-cta { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia-card,
    .ia-card-img,
    .ia-card-tint,
    .ia-card-title,
    .ia-card-desc,
    .ia-card-cta { transition: none !important; }
  }
</style>

<script>
  // Each accordion on the page is hydrated independently (multiple instances
  // can co-exist on one route). We scope queries to the accordion root.
  document
    .querySelectorAll<HTMLElement>("[data-image-accordion]")
    .forEach((root) => {
      const cards = Array.from(
        root.querySelectorAll<HTMLElement>("[data-ia-card]"),
      );
      if (!cards.length) return;

      const initial = Number(root.dataset.initial ?? cards.length - 1);

      const setActive = (idx: number) => {
        cards.forEach((c, i) => c.classList.toggle("is-active", i === idx));
      };
      setActive(initial);

      const isTouch = !window.matchMedia("(hover: hover)").matches;

      cards.forEach((card, i) => {
        if (!isTouch) {
          card.addEventListener("mouseenter", () => setActive(i));
          card.addEventListener("focus", () => setActive(i));
        } else {
          card.addEventListener("click", (e) => {
            if (!card.classList.contains("is-active")) {
              // First tap activates without navigating; second tap (now active)
              // follows the link (if any).
              e.preventDefault();
              setActive(i);
            }
          });
        }
      });
    });
</script>
