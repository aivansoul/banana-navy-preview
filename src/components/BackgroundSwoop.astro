---
/**
 * BackgroundSwoop.astro — yellow Lusion-style serpentine line that draws
 * progressively as the user scrolls.
 *
 * Implementation:
 *   • One absolutely-positioned SVG spanning the parent (which must be
 *     position:relative). preserveAspectRatio="none" makes the path
 *     stretch to fill the page height regardless of how tall it grows.
 *   • A single thick `<path>` with stroke-linecap: round.
 *   • A vanilla scroll listener pegs `stroke-dashoffset` to scrollY /
 *     scrollMax so the line is "drawn" from top to bottom of the page.
 *   • Sits at z-index 0 with mix-blend-mode: multiply — yellow on the
 *     lilac canvas reads as a saturated ochre that doesn't fight text.
 *
 * Accessibility: aria-hidden + respects prefers-reduced-motion (no
 * animation, the line still renders at 30% drawn so the brand mark
 * is visible).
 */
---
<div class="swoop-wrap" aria-hidden="true">
  <svg
    class="swoop-svg"
    viewBox="0 0 1000 5000"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    {/* Serpentine path — sweeps left/right across the entire page height.
        Hand-tuned so the arcs cross editorial sections (hero / 5-couches /
        livre / CTA) at flattering offsets. */}
    <path
      class="swoop-path"
      d="
        M -120 220
        C 320 360, 760 80, 1120 480
        C 1180 920, 220 1080, 80 1700
        C -40 2200, 980 2280, 1120 2820
        C 1180 3320, -80 3360, 240 3960
        C 460 4360, 980 4180, 1120 4720
      "
      fill="none"
      stroke="var(--accent, #fcff61)"
      stroke-width="12"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>

<style>
  .swoop-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .swoop-svg {
    width: 100%;
    height: 100%;
    display: block;
    /* Yellow on lilac reads cleanly — no multiply needed at this stroke width. */
    opacity: 1;
  }
  .swoop-path {
    /* JS sets --swoop-len + --swoop-offset on mount. Until then the line
       is fully hidden (offset = full length). */
    stroke-dasharray: var(--swoop-len, 12000);
    stroke-dashoffset: var(--swoop-offset, 12000);
    /* No transition — dashoffset is rewritten on every scroll rAF tick so
       the line follows the scroll position exactly (no easing, no lag). */
  }

  @media (prefers-reduced-motion: reduce) {
    .swoop-path {
      /* Static partial reveal — no scroll-coupled motion. */
      stroke-dashoffset: calc(var(--swoop-len, 12000) * 0.4);
    }
  }
</style>

<script>
  const svg = document.querySelector<SVGSVGElement>(".swoop-svg");
  const wrap = document.querySelector<HTMLElement>(".swoop-wrap");
  const path = svg?.querySelector<SVGPathElement>(".swoop-path");

  if (svg && wrap && path) {
    // Measure path length once on mount.
    const len = path.getTotalLength();
    svg.style.setProperty("--swoop-len", String(len));
    svg.style.setProperty("--swoop-offset", String(len));

    // The drawing "head" tracks a fixed point inside the viewport (60%
    // down). As the user scrolls, the freshly-drawn portion of the line
    // is always visible just below their focal point — never far above
    // or below the screen. This makes the drawing feel like it's
    // happening *here, now* instead of catching up to scroll position.
    const HEAD_VIEWPORT_RATIO = 0.6;

    let ticking = false;

    const apply = () => {
      const rect = wrap.getBoundingClientRect();
      const vh = window.innerHeight;
      // Y of the drawing head, in viewport-relative pixels.
      const headViewportY = vh * HEAD_VIEWPORT_RATIO;
      // Convert to "Y inside the swoop wrapper" (0 = top of wrapper).
      const headInsideWrapper = headViewportY - rect.top;
      // Normalize to 0..1 over the wrapper's height.
      const t =
        rect.height > 0
          ? Math.min(1, Math.max(0, headInsideWrapper / rect.height))
          : 0;
      svg.style.setProperty("--swoop-offset", String(len * (1 - t)));
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(apply);
      }
    };

    apply();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", apply);
  }
</script>
