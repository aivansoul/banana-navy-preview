---
/**
 * Streaming chat UI for both /team/* and /demo-agents/* pages.
 *
 * Vanilla JS, no framework. Streams Anthropic SSE deltas into the message log.
 */
interface Props {
  /** API endpoint to POST messages to. */
  endpoint: "/api/agents/team" | "/api/agents/demo";
  /** Agent slug — passed in every request body. */
  agentSlug: string;
  /** Human-readable agent name shown above the chat. */
  agentName: string;
  /** One-line description shown under the name. */
  agentTagline: string;
  /** Demo flag — adds a turn-counter cap via localStorage. */
  isDemo?: boolean;
  /** Hard cap on turns per browser session (demo only). */
  maxTurns?: number;
}
const {
  endpoint,
  agentSlug,
  agentName,
  agentTagline,
  isDemo = false,
  maxTurns = 6,
} = Astro.props;
---
<div
  class="agent-chat"
  data-endpoint={endpoint}
  data-agent-slug={agentSlug}
  data-is-demo={isDemo ? "1" : "0"}
  data-max-turns={String(maxTurns)}
>
  <header class="agent-chat-head">
    <div>
      <div class="eyebrow mono"><span class="dot"></span>Agent · {agentName}</div>
      <h1 class="display h2" style="margin-top: 12px;">{agentName}</h1>
      <p class="body-m" style="margin-top: 8px; max-width: 60ch;">{agentTagline}</p>
    </div>
    {isDemo && (
      <div class="agent-chat-demo-banner">
        Démo · réponses bridées · {maxTurns} tours / session
      </div>
    )}
  </header>

  <div class="agent-chat-log" aria-live="polite"></div>

  <form class="agent-chat-form">
    <textarea
      class="agent-chat-input"
      name="message"
      rows="3"
      placeholder={
        isDemo
          ? "Décris ton besoin business en quelques mots…"
          : "GOAL: … / CONTEXT: … / CONSTRAINTS: … / DEFINITION OF DONE: …"
      }
      required
    ></textarea>
    <div class="agent-chat-actions">
      <button type="submit" class="btn-yellow agent-chat-send">Envoyer →</button>
      <button type="button" class="btn-line agent-chat-reset">Recommencer</button>
      <span class="agent-chat-status mono"></span>
    </div>
  </form>
</div>

<style>
  .agent-chat { display: grid; gap: 32px; }
  .agent-chat-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
  }
  .agent-chat-demo-banner {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 12px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .agent-chat-log {
    display: grid;
    gap: 24px;
    min-height: 200px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 24px;
    border: 1px solid var(--fg-10);
    background: rgba(255, 255, 255, 0.02);
  }
  .agent-chat-msg { display: grid; gap: 6px; }
  .agent-chat-msg .role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-40);
  }
  .agent-chat-msg.user .role { color: var(--accent); }
  .agent-chat-msg .body {
    font-size: 15px;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--fg);
  }
  .agent-chat-msg.user .body { color: var(--fg-60); }
  .agent-chat-form { display: grid; gap: 12px; }
  .agent-chat-input {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--fg-20);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 14px;
    resize: vertical;
    min-height: 80px;
  }
  .agent-chat-input:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .agent-chat-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .agent-chat-status { color: var(--fg-40); font-size: 11px; }
  .agent-chat-status.is-error { color: #ff7676; }
</style>

<script>
  const SESSION_KEY_PREFIX = "bn-agent-turns-";

  document.querySelectorAll<HTMLElement>(".agent-chat").forEach((root) => {
    const endpoint = root.dataset.endpoint!;
    const agentSlug = root.dataset.agentSlug!;
    const isDemo = root.dataset.isDemo === "1";
    const maxTurns = Number(root.dataset.maxTurns || "6");
    const sessionKey = SESSION_KEY_PREFIX + agentSlug;

    const log = root.querySelector<HTMLElement>(".agent-chat-log")!;
    const form = root.querySelector<HTMLFormElement>(".agent-chat-form")!;
    const input = root.querySelector<HTMLTextAreaElement>(".agent-chat-input")!;
    const send = root.querySelector<HTMLButtonElement>(".agent-chat-send")!;
    const reset = root.querySelector<HTMLButtonElement>(".agent-chat-reset")!;
    const status = root.querySelector<HTMLElement>(".agent-chat-status")!;

    let messages: Array<{ role: "user" | "assistant"; content: string }> = [];

    function setStatus(text: string, isError = false) {
      status.textContent = text;
      status.classList.toggle("is-error", isError);
    }

    function turnsUsedThisBrowserSession(): number {
      if (!isDemo) return 0;
      try {
        return Number(localStorage.getItem(sessionKey) || "0");
      } catch {
        return 0;
      }
    }

    function bumpTurnCounter() {
      if (!isDemo) return;
      try {
        localStorage.setItem(sessionKey, String(turnsUsedThisBrowserSession() + 1));
      } catch {}
    }

    function renderMessage(role: "user" | "assistant", body: string): HTMLElement {
      const wrap = document.createElement("div");
      wrap.className = "agent-chat-msg " + role;
      const r = document.createElement("div");
      r.className = "role";
      r.textContent = role === "user" ? "Vous" : "Agent";
      const b = document.createElement("div");
      b.className = "body";
      b.textContent = body;
      wrap.appendChild(r);
      wrap.appendChild(b);
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
      return b;
    }

    reset.addEventListener("click", () => {
      messages = [];
      log.replaceChildren();
      setStatus("");
      try { localStorage.removeItem(sessionKey); } catch {}
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      if (isDemo && turnsUsedThisBrowserSession() >= maxTurns) {
        setStatus(`Limite démo atteinte (${maxTurns} tours). Réserve un audit gratuit pour aller plus loin.`, true);
        return;
      }

      input.value = "";
      send.disabled = true;
      setStatus("…");

      messages.push({ role: "user", content: text });
      renderMessage("user", text);
      const assistantBody = renderMessage("assistant", "");

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ agent: agentSlug, messages }),
          credentials: "include",
        });

        if (!res.ok) {
          const errBody = await res.text();
          let label = `Erreur ${res.status}`;
          try {
            const parsed = JSON.parse(errBody);
            if (parsed.error) label = parsed.error;
          } catch {}
          setStatus(label, true);
          assistantBody.textContent = "[la réponse n'a pas abouti — voir le statut]";
          send.disabled = false;
          return;
        }

        const reader = res.body!.getReader();
        const decoder = new TextDecoder();
        let buf = "";
        let fullText = "";

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });

          let idx;
          while ((idx = buf.indexOf("\n\n")) !== -1) {
            const block = buf.slice(0, idx);
            buf = buf.slice(idx + 2);
            const lines = block.split("\n");
            let event = "";
            let data = "";
            for (const line of lines) {
              if (line.startsWith("event:")) event = line.slice(6).trim();
              else if (line.startsWith("data:")) data += line.slice(5).trim();
            }
            if (!data) continue;
            try {
              const parsed = JSON.parse(data);
              if (event === "content_block_delta" && parsed.delta?.type === "text_delta") {
                fullText += parsed.delta.text;
                assistantBody.textContent = fullText;
                log.scrollTop = log.scrollHeight;
              }
            } catch {}
          }
        }

        messages.push({ role: "assistant", content: fullText });
        bumpTurnCounter();
        if (isDemo) {
          const left = maxTurns - turnsUsedThisBrowserSession();
          setStatus(left > 0 ? `${left} tour(s) restant(s) cette session.` : `Dernier tour — réserve un audit pour continuer.`);
        } else {
          setStatus("");
        }
      } catch (err) {
        setStatus(String(err), true);
      } finally {
        send.disabled = false;
        input.focus();
      }
    });
  });
</script>
