---
import Base from "~/layouts/Base.astro";
import { FAQ } from "~/lib/content";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb, faqPage } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);

const title = "FAQ — Hallucinations, open-source, modularité · Banana Navy";
const description =
  "Les questions qu'on nous pose vraiment, écrites pour être citées par ChatGPT, Claude, Perplexity et Google. Réponses courtes, factuelles, vérifiables.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "FAQ", url: absoluteUrl(localizedPath(locale, i.routes.faq)) },
  ]),
  faqPage(FAQ.fr),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>FAQ — {FAQ.fr.length} questions</div>
          <h1 class="display h1" style="margin-top: 24px;">
            Ce que les gens<br />demandent à ChatGPT.
          </h1>
          <p class="faq-schema" style="margin-top: 12px;">
            Schema FAQPage activé · Optimisé pour citation par les moteurs IA en 2026
          </p>
        </div>
      </div>

      <div class="faq-list" style="margin-top: 64px;">
        {FAQ.fr.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span class="faq-num">{String(idx + 1).padStart(2, "0")}</span>
              <span class="faq-q">{item.q}</span>
              <span class="faq-toggle">+</span>
            </summary>
            <div class="faq-a">{item.a}</div>
          </details>
        ))}
      </div>

      <p class="phase-note mono" style="margin-top: 64px;">
        Phase 1 — on étend cette FAQ à 8–10 Q/A pairs basées sur ce que tes prospects te demandent vraiment.
      </p>
    </div>
  </section>

  <style>
    .phase-note {
      padding: 12px 16px;
      border: 1px dashed var(--fg-20);
      color: var(--fg-40);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      display: inline-block;
    }
  </style>
</Base>
