---
import Base from "~/layouts/Base.astro";
import { SITE, absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);

const title = "Conditions générales de vente · Banana Navy SRL";
const description =
  "Conditions générales de vente applicables aux prestations de Banana Navy SRL : devis, commande, facturation, propriété intellectuelle, litiges.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "CGV", url: absoluteUrl(localizedPath(locale, i.routes.cgv)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <section class="section">
    <div class="container" style="max-width: 760px;">
      <div class="eyebrow mono"><span class="dot"></span>Légal · CGV</div>
      <h1 class="display h1" style="margin-top: 24px;">Conditions générales de vente</h1>
      <div class="legal-body">
        <p>Les présentes CGV régissent les prestations fournies par {SITE.legalName} (audit, conception et intégration de systèmes IA modulaires, opération continue, support).</p>
        <p class="phase-note mono">Phase 1 — version courte placeholder. Le contenu complet est à valider avec votre conseil avant publication.</p>
      </div>
    </div>
  </section>
  <style>
    .legal-body { margin-top: 40px; display: grid; gap: 20px; color: var(--fg-60); font-size: 15px; line-height: 1.65; }
    .phase-note { padding: 12px 16px; border: 1px dashed var(--fg-20); color: var(--fg-40); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; display: inline-block; }
  </style>
</Base>
