---
import Base from "~/layouts/Base.astro";
import StubPage from "~/components/StubPage.astro";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);
const r = i.routes;
const link = (path: string) => localizedPath(locale, path);

const title = "Équipe — Qui construit Banana Navy · Charleroi";
const description =
  "L'équipe derrière Banana Navy. Une petite équipe pluri-disciplinaire à Charleroi : ingénieurs IA, designers, et un·e Chief of Staff qui tient la barre.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "Équipe", url: absoluteUrl(localizedPath(locale, i.routes.equipe)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema} bodyClass="press-light">
  <StubPage
    locale={locale}
    eyebrow="Équipe — Charleroi"
    heading="Petite équipe. Décisions rapides. Stack moderne."
    intro="Une équipe pluri-disciplinaire (ingénierie IA, design, ops) basée à Charleroi. On bouge léger pour livrer vite et garder vos systèmes à jour avec ce qui sort de nouveau chaque mois."
    phaseNote="Phase 1 — donne-moi la liste réelle (prénom, rôle, photo, mini-bio) et je la mets en place avec Person schema pour chaque membre."
  />

  <section class="section-sm" aria-label="Réalisations">
    <div class="container">
      <div class="equipe-realisations">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Réalisations</div>
          <h2 class="display h3" style="margin-top: 16px;">Ce que l'équipe a livré.</h2>
        </div>
        <a class="equipe-realisations-cta" href={link(r.realisations)}>
          <span>Voir nos réalisations</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <style>
    .equipe-realisations {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      padding-top: 32px;
      border-top: 1px solid var(--fg-10);
    }
    .equipe-realisations-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 14px 26px;
      border-radius: 999px;
      background: #0a0a0a;
      color: #fff;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .equipe-realisations-cta:hover { background: var(--accent, #fcff61); color: #0a0a0a; }
  </style>
</Base>
