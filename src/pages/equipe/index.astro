---
import Base from "~/layouts/Base.astro";
import StubPage from "~/components/StubPage.astro";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);

const title = "Équipe — Qui construit Banana Navy · Charleroi";
const description =
  "L'équipe derrière Banana Navy. Une petite équipe pluri-disciplinaire à Charleroi : ingénieurs IA, designers, et un·e Chief of Staff qui tient la barre.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "Équipe", url: absoluteUrl(localizedPath(locale, i.routes.equipe)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <StubPage
    locale={locale}
    eyebrow="Équipe — Charleroi"
    heading="Petite équipe. Décisions rapides. Stack moderne."
    intro="Une équipe pluri-disciplinaire (ingénierie IA, design, ops) basée à Charleroi. On bouge léger pour livrer vite et garder vos systèmes à jour avec ce qui sort de nouveau chaque mois."
    phaseNote="Phase 1 — donne-moi la liste réelle (prénom, rôle, photo, mini-bio) et je la mets en place avec Person schema pour chaque membre."
  />
</Base>
