---
import Base from "~/layouts/Base.astro";
import StubPage from "~/components/StubPage.astro";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "nl" as const;
const i = t(locale);

const title = "Team — Wie Banana Navy bouwt · Charleroi";
const description =
  "Het team achter Banana Navy. Een klein multidisciplinair team in Charleroi: AI-ingenieurs, designers en een Chief of Staff die het roer in handen houdt.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/nl/") },
    { name: "Team", url: absoluteUrl(localizedPath(locale, i.routes.equipe)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <StubPage
    locale={locale}
    eyebrow="Team — Charleroi"
    heading="Klein team. Snelle beslissingen. Moderne stack."
    intro="Een multidisciplinair team (AI-engineering, design, ops) in Charleroi. We bewegen licht om snel te leveren en je systemen up-to-date te houden met wat er elke maand nieuw uitkomt."
    phaseNote="Fase 1 — bezorg me de echte lijst (voornaam, rol, foto, mini-bio) en ik zet alles op met Person-schema per teamlid."
  />
</Base>
