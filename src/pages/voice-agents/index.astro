---
import Base from "~/layouts/Base.astro";
import CategoryOverview from "~/components/CategoryOverview.astro";
import { SERVICE_CATEGORIES } from "~/lib/content";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb, service } from "~/lib/schema";

const locale = "fr" as const;
const link = (p: string) => localizedPath(locale, p);
const category = SERVICE_CATEGORIES.find((c) => c.slug === "voice-agents")!;

const title = "Agents vocaux IA en Belgique | Banana Navy";
const description =
  "Agents vocaux IA pour répondre aux appels, qualifier les leads, réserver des rendez-vous et automatiser le suivi client en français, néerlandais et anglais.";

const url = absoluteUrl(link("/voice-agents/"));
const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: category.head, url },
  ]),
  ...category.leaves.map((leaf) =>
    service({
      name: leaf.name[locale],
      description: leaf.claim[locale],
      url: absoluteUrl(link(`/${category.slug}/${leaf.slug}/`)),
      category: category.head,
    }),
  ),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <CategoryOverview locale={locale} category={category} />
</Base>
