---
import Base from "~/layouts/Base.astro";
import { SITE, absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);

const title = "Contact — Audit IA 60 minutes | Banana Navy";
const description =
  "Contactez Banana Navy pour un audit IA de 60 minutes : agents vocaux, automatisations CRM, systèmes agentiques, SEO/GEO et sites IA-ready.";

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "Contact", url: absoluteUrl(localizedPath(locale, i.routes.contact)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Contact · Audit IA 60 minutes</div>
          <h1 class="display h1" style="margin-top: 24px;">
            Parlons de votre premier<br /><span class="h-accent">système IA.</span>
          </h1>
          <p class="body-l" style="color: var(--fg-60); max-width: 60ch; margin-top: 28px;">
            Vous n'avez pas besoin de savoir quel outil choisir. Venez avec un problème concret : appels manqués, leads non suivis, CRM mal utilisé, support saturé, site invisible ou processus trop manuel. Nous vous aidons à identifier le premier système IA qui peut produire un impact mesurable.
          </p>
        </div>
      </div>

      <div class="contact-grid" style="margin-top: 80px;">
        <form action="/api/contact" method="post" class="contact-form">
          <div class="contact-form-title eyebrow mono"><span class="dot"></span>Demander un audit IA</div>

          <label>
            <span>Nom</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Entreprise</span>
            <input type="text" name="company" autocomplete="organization" />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>Téléphone</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="+32…" />
          </label>

          <fieldset class="contact-radio">
            <legend>Langue préférée</legend>
            <label class="radio-pill">
              <input type="radio" name="lang" value="fr" checked />
              <span>FR</span>
            </label>
            <label class="radio-pill">
              <input type="radio" name="lang" value="nl" />
              <span>NL</span>
            </label>
            <label class="radio-pill">
              <input type="radio" name="lang" value="en" />
              <span>EN</span>
            </label>
          </fieldset>

          <label>
            <span>Sujet</span>
            <select name="subject" required>
              <option value="">— Choisir un sujet —</option>
              <option value="voice-agent">Voice Agent</option>
              <option value="automatisation">Automatisation</option>
              <option value="agentic-systems">Agentic Systems</option>
              <option value="seo-geo">SEO / GEO</option>
              <option value="site-ia-ready">Site IA-ready</option>
              <option value="autre">Autre</option>
            </select>
          </label>

          <label>
            <span>Message</span>
            <textarea name="message" rows="4" required placeholder="En une phrase, votre besoin."></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" name="rgpd" required />
            <span>J'accepte que mes données soient traitées pour répondre à ma demande (RGPD).</span>
          </label>

          <button type="submit" class="btn-yellow">Envoyer la demande →</button>

          <p class="microcopy">
            Réponse sous 1 à 2 jours ouvrables. Pour un agent vocal starter, le premier audit dure 60 minutes.
          </p>
        </form>

        <aside class="contact-side">
          <h2 class="display h4">Ou directement</h2>
          <p class="body-m" style="margin-top: 12px;">
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
            <a href={`tel:${SITE.phone.replace(/\s/g, "")}`}>{SITE.phone}</a>
          </p>
          <p class="body-s" style="margin-top: 24px;">
            {SITE.legalName}<br />
            {SITE.address.street}<br />
            {SITE.address.postalCode} {SITE.address.city}<br />
            {SITE.address.countryName}
          </p>
          <p class="body-s" style="margin-top: 16px;">TVA {SITE.vatNumber}</p>
        </aside>
      </div>
    </div>
  </section>

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 64px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .contact-grid { grid-template-columns: 1fr; }
    }
    .contact-form {
      display: grid;
      gap: 20px;
    }
    .contact-form label {
      display: grid;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fg-60);
    }
    .contact-form input,
    .contact-form textarea,
    .contact-form select {
      width: 100%;
      padding: 14px 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--fg-20);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 14px;
      letter-spacing: normal;
      text-transform: none;
      border-radius: 0;
    }
    .contact-form input:focus,
    .contact-form textarea:focus,
    .contact-form select:focus {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .contact-form-title {
      margin-bottom: 8px;
    }
    .contact-radio {
      border: 0;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 12px;
    }
    .contact-radio legend {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fg-60);
      margin-bottom: 4px;
    }
    .contact-radio {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .contact-radio > legend + label,
    .contact-radio > label { display: flex; }
    .contact-radio { flex-direction: row; flex-wrap: wrap; }
    .contact-radio > legend { width: 100%; }
    .radio-pill {
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border: 1px solid var(--fg-20);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fg-60);
      transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .radio-pill input { display: none; }
    .radio-pill:hover { border-color: var(--accent); color: var(--fg); }
    .radio-pill:has(input:checked) {
      border-color: var(--accent);
      background: rgba(255, 215, 56, 0.08);
      color: var(--fg);
    }
    .contact-form .consent {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      flex-direction: row;
      text-transform: none;
      letter-spacing: 0;
      font-family: var(--font-body);
      font-size: 12px;
      line-height: 1.5;
    }
    .contact-form .consent input { width: auto; margin-top: 4px; }
    .microcopy {
      font-size: 12px;
      line-height: 1.55;
      color: var(--fg-60);
      max-width: 50ch;
      margin-top: 4px;
    }
  </style>
</Base>
