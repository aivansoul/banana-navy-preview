---
import Base from "~/layouts/Base.astro";
import Hero from "~/components/Hero.astro";
import TrustBar from "~/components/TrustBar.astro";
import LayersAccordion from "~/components/LayersAccordion.astro";
import ImageAccordion from "~/components/ImageAccordion.astro";
import type { AccordionItem } from "~/components/ImageAccordion.astro";
import BackgroundSwoop from "~/components/BackgroundSwoop.astro";
import FinalCtaCinematic from "~/components/FinalCtaCinematic.astro";
import WaterBackground from "~/components/WaterBackground.astro";
import MethodCards from "~/components/MethodCards.astro";
import { faqPage, breadcrumb, service } from "~/lib/schema";
import {
  TRUST_CLIENTS,
  SERVICE_CATEGORIES,
  PILLARS_3,
  LAYERS_5,
  POSITIONING,
  META_DESCRIPTION,
  METHOD_STEPS,
  FAQ,
  CASE_PREVIEWS,
  PILLARS,
  ALL_LEAVES,
} from "~/lib/content";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { t } from "~/lib/i18n";

const locale = "fr" as const;
const i = t(locale);
const r = i.routes;
const link = (p: string) => localizedPath(locale, p);

const title = "Banana Navy — Agents vocaux IA, automatisations et systèmes agentiques";
const description = META_DESCRIPTION.fr;

const POURQUOI_BULLETS = [
  "Audit IA de 60 minutes avant tout build.",
  "Premier agent vocal fonctionnel possible en 1 semaine.",
  "Starter pack voix à partir de 3.000 €.",
  "Français, néerlandais et anglais.",
  "Belgique, Wallonie, Flandre et projets remote.",
  "Architecture pensée pour SEO, GEO et AI Search.",
];

const CE_QU_ON_LIVRE = [
  {
    key: "communication",
    title: "Communication",
    body: "Agents vocaux IA pour appels entrants, qualification, prise de rendez-vous, support de premier niveau et relances automatisées.",
  },
  {
    key: "crm-sales-ops",
    title: "CRM & sales ops",
    body: "Automatisations CRM, routage de leads, enrichissement, scoring, rappels, relances J+3, reporting commercial et pipelines plus propres.",
  },
  {
    key: "orchestration",
    title: "Orchestration agentique",
    body: "Systèmes multi-agents capables de coordonner recherche, décision, génération, validation humaine et exécution dans vos outils.",
  },
  {
    key: "visibility",
    title: "Visibilité",
    body: "Sites IA-ready, SEO technique, GEO, schema.org, llms.txt, markdown mirrors, pages services et pages locales pour être trouvé par Google et cité par les IA.",
  },
  {
    key: "infrastructure",
    title: "Infrastructure",
    body: "Déploiement Cloudflare, APIs, webhooks, logs, monitoring, documentation, fallback humain et architecture évolutive.",
  },
];

/* ============================================================
   MOODBOARD IMAGES for the two extra image accordions on this page.
   Cinematic, B&W-friendly Unsplash shots — swap with brand photography
   when assets are ready.
   ============================================================ */
const LIVRE_IMAGES: Record<string, string> = {
  communication:  "https://images.unsplash.com/photo-1590602847861-f357a9332bbc?q=80&w=1400&auto=format&fit=crop", // close-up mic
  "crm-sales-ops": "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1400&auto=format&fit=crop", // dashboards
  orchestration:  "https://images.unsplash.com/photo-1511497584788-876760111969?q=80&w=1400&auto=format&fit=crop", // orchestra
  visibility:     "https://images.unsplash.com/photo-1547658719-da2b51169166?q=80&w=1400&auto=format&fit=crop",  // moody screen
  infrastructure: "https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1400&auto=format&fit=crop", // circuit board
};

const LIVRE_ITEMS: AccordionItem[] = CE_QU_ON_LIVRE.map((item, idx) => ({
  key: item.key,
  num: String(idx + 1).padStart(2, "0"),
  name: item.title,
  desc: item.body,
  image: LIVRE_IMAGES[item.key] ?? "",
  // Orchestration is the keystone — same narrative as the 5-layer accordion.
  keystone: item.key === "orchestration",
}));

const TRUST_IMAGES: Record<string, string> = {
  "01": "https://images.unsplash.com/photo-1614064641938-3bbee52942c7?q=80&w=1400&auto=format&fit=crop", // EU map / globe
  "02": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=1400&auto=format&fit=crop", // modular blocks / data center
  "03": "https://images.unsplash.com/photo-1521791136064-7986c2920216?q=80&w=1400&auto=format&fit=crop", // handshake / human
};

const TRUST_ITEMS: AccordionItem[] = PILLARS.map((p, idx) => ({
  key: p.num,
  num: p.num,
  name: p.title.fr,
  desc: p.body.fr,
  image: TRUST_IMAGES[p.num] ?? "",
  // Middle pillar (Modularité) is highlighted — it's the keystone idea here.
  keystone: idx === 1,
}));

const schema = [
  faqPage(FAQ.fr),
  breadcrumb([{ name: "Banana Navy", url: absoluteUrl("/") }]),
  // One Service schema per leaf — gives AI engines the full taxonomy.
  ...ALL_LEAVES.map((leaf) =>
    service({
      name: leaf.name[locale],
      description: leaf.claim[locale],
      url: absoluteUrl(link(`/${leaf.categorySlug}/${leaf.slug}/`)),
      category: SERVICE_CATEGORIES.find((c) => c.slug === leaf.categorySlug)!.head,
    }),
  ),
];
---
<Base
  locale={locale}
  title={title}
  description={description}
  schema={schema}
  bodyClass="press-light home-water"
>
  <WaterBackground />

  <Hero
    intro="Nous intégrons l'IA dans vos systèmes existants pour éliminer les tâches répétitives et créer des workflows qui donnent un avantage réel."
    titleLines={["Intégrez l'IA", "Gardez le contrôle"]}
    ctaPrimary={{ label: "Découvrir l'approche", href: link(r.approche) }}
    ctaSecondary={{ label: "Voir l'équipe", href: link(r.equipe) }}
  />

  <div class="page-with-swoop">
  {/* Yellow Lusion-style accent line — drawn progressively on scroll.
      Sits behind every section below the hero. */}
  <BackgroundSwoop />

  <TrustBar label="Ils nous ont fait confiance" clients={[...TRUST_CLIENTS]} />

  {/* INTRO SEO/GEO */}
  <section class="section" id="intro" aria-label="Présentation">
    <div class="container">
      <div class="intro-block">
        <p class="intro-lead">
          Banana Navy est un studio IA basé en Belgique, spécialisé dans les agents vocaux IA, l'automatisation CRM, l'orchestration agentique et l'optimisation SEO/GEO. Nous travaillons avec des PME, équipes commerciales, services client et directions opérationnelles qui veulent déployer des systèmes IA utiles, mesurables et évolutifs.
        </p>
        <p class="intro-body">
          Un premier agent vocal fonctionnel peut être livré en une semaine à partir de <strong>3.000 €</strong>. Les systèmes plus avancés — intégrations CRM, workflows multi-agents, automatisations internes, RAG, observabilité ou hébergement européen — sont conçus après un audit de 60 minutes.
        </p>
      </div>
    </div>
  </section>

  {/* POURQUOI BANANA NAVY */}
  <section class="section" id="pourquoi" aria-label="Pourquoi Banana Navy">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Pourquoi Banana Navy</div>
          <h2 class="display h2" style="margin-top: 24px;">
            Pas des outils isolés.<br />
            <span style="color: var(--fg-60);">Des systèmes qui évoluent.</span>
          </h2>
        </div>
      </div>
      <div class="pourquoi-grid">
        <div class="pourquoi-copy">
          <p>
            La plupart des projets IA commencent avec un chatbot, une automatisation Make ou une démo qui impressionne pendant une semaine. Puis les modèles changent, les outils changent, les équipes ne savent plus quoi modifier, et le système devient fragile.
          </p>
          <p>
            Banana Navy travaille autrement. Nous concevons des systèmes modulaires : un agent vocal peut changer de fournisseur voix, un workflow CRM peut passer de Make à n8n, une couche LLM peut basculer de Claude à Mistral ou OpenAI, et une base documentaire peut évoluer sans reconstruire tout le projet.
          </p>
          <p>
            Notre objectif n'est pas de vous enfermer dans un outil. Notre objectif est de vous donner une infrastructure IA que votre entreprise peut comprendre, exploiter et faire évoluer.
          </p>
        </div>
        <ul class="pourquoi-bullets">
          {POURQUOI_BULLETS.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* 3 PILLARS */}
  <section class="section" id="pillars" aria-label="3 piliers">
    <div class="container">
      <div class="levers-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>3 piliers — Agents · Create · Automate</div>
          <h2 class="display h2" style="margin-top: 24px;">Trois piliers.<br />Un seul système.</h2>
        </div>
        <p class="body-l" style="color: var(--fg-60); max-width: 480px;">
          On conçoit des <strong>systèmes agentiques modulaires</strong> qui automatisent la communication, les opérations, la génération de leads et la croissance digitale. Trois piliers, cinq couches, une seule logique : on construit pour que la tech qui bouge ne casse pas votre business — modules interchangeables, jamais d'obsolescence à 12 mois.
        </p>
      </div>

      <div class="pillars-3">
        {PILLARS_3.map((p, idx) => (
          <article class="pillar-3">
            {/* Levitating placeholder — visual lead-in above the plain text. */}
            <div class="pillar-3-placeholder" aria-hidden="true">
              <span class="placeholder-chip">{p.title.fr}</span>
              <span class="placeholder-num">{String(idx + 1).padStart(2, "0")}</span>
            </div>

            <div class="pillar-3-head">
              <span class="pillar-3-key">{p.title.fr}</span>
            </div>
            <p class="pillar-3-tagline">{p.tagline.fr}</p>
            <div class="pillar-3-cats">
              {p.categories.map((slug) => {
                const cat = SERVICE_CATEGORIES.find((c) => c.slug === slug)!;
                return (
                  <a href={link(`/${cat.slug}/`)} class="pillar-3-cat-link">
                    {cat.head} →
                  </a>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 5 LAYERS */}
  <section class="section" id="layers" aria-label="5 couches">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Architecture — 5 couches</div>
          <h2 class="display h2" style="margin-top: 24px;">
            Cinq couches.<br /><span style="color: var(--fg-60);">Une orchestration.</span>
          </h2>
        </div>
        <p class="body-l" style="color: var(--fg-60); max-width: 480px;">
          Communication, opérations, découverte, interface — et au-dessus de tout, les systèmes agentiques qui orchestrent les quatre autres comme un chef d'orchestre.
        </p>
      </div>

      <LayersAccordion locale={locale} />
    </div>
  </section>

  {/* SERVICES — full 5x cards */}
  <section class="section" id="services" aria-label="Services">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Services — 05 catégories · 13 services</div>
          <h2 class="display h2" style="margin-top: 24px;">Ce qu'on construit pour vous.</h2>
        </div>
      </div>

      <div class="cap-grid">
        {SERVICE_CATEGORIES.map((cat, idx) => (
          <article class="cap-card">
            {/* Levitating placeholder — soft card before the plain text below. */}
            <div class="cap-placeholder" aria-hidden="true">
              <span class="placeholder-chip">{cat.head}</span>
              <span class="placeholder-num">{String(idx + 1).padStart(2, "0")}</span>
              <span class="placeholder-tag">{cat.pillar}</span>
            </div>

            <div class="cap-head">
              <span class="cap-pillar">{cat.head}</span>
              <span class="cap-pillar-tag">{cat.pillar}</span>
            </div>
            <p class="cap-one">{cat.one_liner.fr}</p>
            <ul class="cap-leaves">
              {cat.leaves.map((leaf) => (
                <li>
                  <a href={link(`/${cat.slug}/${leaf.slug}/`)}>{leaf.name.fr}</a>
                </li>
              ))}
            </ul>
            <a href={link(`/${cat.slug}/`)} class="cap-cta">
              Explorer {cat.head} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* CE QU'ON LIVRE */}
  <section class="section" id="livre" aria-label="Ce qu'on livre">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Ce qu'on livre · 05 domaines</div>
          <h2 class="display h2" style="margin-top: 24px;">
            Une couche IA opérationnelle<br />
            <span style="color: var(--fg-60);">autour de votre business.</span>
          </h2>
        </div>
      </div>
      <ImageAccordion items={LIVRE_ITEMS} defaultCta="Voir" hrefless />
    </div>
  </section>

  {/* METHOD */}
  <section class="section" id="method" aria-label="Notre méthode">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Notre méthode — 04 étapes</div>
          <h2 class="display h2" style="margin-top: 24px;">4 étapes.<br />Pas de zones d'ombre.</h2>
        </div>
        <p class="body-l" style="color: var(--fg-60); max-width: 360px;">
          La dernière étape est celle que les autres oublient. C'est la nôtre.
        </p>
      </div>
      <MethodCards locale="fr" />
    </div>
  </section>

  {/* TRUST LAYER */}
  <section class="section" id="trust-layer" aria-label="Trust Layer">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>Trust Layer — 03 piliers</div>
          <h2 class="display h2 trust-h2" style="margin-top: 24px;">
            Pas de boîte noire.<br /><span style="color: var(--fg-60);">Vos données restent les vôtres.</span>
          </h2>
        </div>
        <div class="trust-layer-copy">
          <p>
            On préfère les modèles open-source quand c'est possible. On documente nos guardrails. On construit des architectures modulaires — quand un meilleur modèle sort dans 6 mois, on swap le module, pas le système. Et on vous montre exactement où passent vos données : chaque prompt, chaque appel, chaque log.
          </p>
          <a href={link(r.approche)} class="trust-layer-link">Lire notre approche complète →</a>
        </div>
      </div>

      <ImageAccordion items={TRUST_ITEMS} defaultCta="En savoir +" hrefless />
    </div>
  </section>

  {/* FAQ */}
  <section class="section" id="faq" aria-label="Questions fréquentes">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow mono"><span class="dot"></span>FAQ — {FAQ.fr.length} questions</div>
          <h2 class="display h2" style="margin-top: 24px;">Ce que les gens<br />demandent à ChatGPT.</h2>
          <p class="faq-schema">Schema FAQPage activé · Optimisé pour citation par les moteurs IA en 2026</p>
        </div>
      </div>
      <div class="faq-list">
        {FAQ.fr.map((item, idx) => (
          <details class="faq-item">
            <summary>
              <span class="faq-num">{String(idx + 1).padStart(2, "0")}</span>
              <span class="faq-q">{item.q}</span>
              <span class="faq-toggle">+</span>
            </summary>
            <div class="faq-a">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* FINAL CTA — cinematic curtain reveal */}
  <FinalCtaCinematic
    eyebrow="Prêt à lancer ?"
    heading="Découvrez ce que l'IA peut faire pour vous."
    accentWord="IA"
    subtitle="Gratuit · Sans engagement · Avec un livrable concret à la fin"
    ctaPrimary={{ label: "Réserver mon audit", href: link(r.contact) }}
    ctaSecondary={{ label: "Rester informé(e)", href: link(r.newsletter) }}
  />
  </div>
</Base>

<style>
  /* ============================================================
     PAGE-WITH-SWOOP — positioned container for the yellow accent line
     ============================================================
     BackgroundSwoop is `position: absolute; inset: 0` and lives at the
     top of this wrapper, so the parent must be the offset parent. Every
     section inside is in normal flow with implicit z-index 0 BUT renders
     in DOM order, so they paint on top of the SVG without needing an
     explicit z-index. Sections with their own opaque background
     (`.section--light`) naturally mask the line where it sits behind. */
  .page-with-swoop {
    position: relative;
    /* Lets the swoop bleed full-bleed at the edges without scrollbars. */
    overflow: hidden;
  }
  /* Make sure every direct child paints above the swoop (z-index 0).
     `position: relative` creates a new stacking context per section. */
  .page-with-swoop > :not(.swoop-wrap) {
    position: relative;
    z-index: 1;
  }

  /* ============ INTRO SEO/GEO ============ */
  .intro-block {
    max-width: 72ch;
    margin: 0 auto;
  }
  .intro-lead {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin-bottom: 24px;
  }
  .intro-body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg-80, var(--fg));
  }
  .intro-body strong { color: var(--accent); font-weight: 600; }
  @media (max-width: 700px) {
    .intro-lead { font-size: 20px; }
  }

  /* ============ POURQUOI ============ */
  .pourquoi-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .pourquoi-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  .pourquoi-copy p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg);
    margin-bottom: 20px;
    max-width: 60ch;
  }
  .pourquoi-copy p:last-child { margin-bottom: 0; }
  .pourquoi-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    border-left: 1px solid var(--fg-10);
    padding-left: 28px;
  }
  .pourquoi-bullets li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg);
  }
  .pourquoi-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .pourquoi-bullets { border-left: none; padding-left: 0; border-top: 1px solid var(--fg-10); padding-top: 24px; }
  }

  /* ============ CE QU'ON LIVRE — stacked horizontal layers ============ */
  .livre-stack {
    margin-top: 64px;
    border-top: 1px solid var(--fg-20);
  }
  .livre-layer {
    display: grid;
    grid-template-columns: 80px 280px 1fr;
    gap: 40px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--fg-20);
    transition: background 0.2s ease;
  }
  .livre-layer:hover { background: rgba(255, 215, 56, 0.04); }
  .livre-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .livre-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .livre-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-60);
    margin: 0;
    max-width: 60ch;
  }
  @media (max-width: 900px) {
    .livre-layer { grid-template-columns: 60px 1fr; gap: 16px; padding: 24px 0; row-gap: 8px; }
    .livre-layer .livre-body { grid-column: 1 / -1; max-width: none; }
  }

  /* ============================================================
     LEVITATING PLACEHOLDER — shared recipe
     A soft floating card that sits above the plain text below, mirroring
     the editorial contrast in the hero (placeholder + chip / plain meta).
     Used by .pillar-3, .cap-card, .case across this page.
     ============================================================ */
  .pillar-3-placeholder,
  .cap-placeholder,
  .case-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: 14px;
    overflow: hidden;
    background:
      /* subtle diagonal hatch to read as a placeholder, very low contrast */
      repeating-linear-gradient(
        135deg,
        rgba(10, 10, 10, 0.03) 0 6px,
        transparent 6px 12px
      ),
      /* Neutral light-gray gradient — sits a clear step darker than the
         near-white canvas (#F4F4F6) so the floating card reads as a
         distinct layer. */
      linear-gradient(160deg, #E6E6EA 0%, #CFCFD5 100%);
    border: 1px solid rgba(10, 10, 10, 0.10);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.65) inset,
      0 18px 42px -22px rgba(10, 10, 10, 0.32),
      0 4px 12px -6px rgba(10, 10, 10, 0.12);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 0.45s ease;
  }
  .pillar-3:hover .pillar-3-placeholder,
  .cap-card:hover .cap-placeholder,
  .case:hover .case-video {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 24px 52px -22px rgba(10, 10, 10, 0.34),
      0 6px 14px -8px rgba(10, 10, 10, 0.14);
  }

  /* Shared chip — yellow pastille top-left of any placeholder */
  .placeholder-chip {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    background: var(--accent, #fcff61);
    color: #0a0a0a;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 2px;
  }
  /* Year / index — top-right of placeholder */
  .placeholder-num {
    position: absolute;
    top: 16px;
    right: 18px;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: rgba(10, 10, 10, 0.55);
  }
  /* Pillar / tag — top-left of placeholder (smaller eyebrow) */
  .placeholder-tag {
    position: absolute;
    top: 16px;
    left: 18px;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.5);
