---
import Base from "~/layouts/Base.astro";
import AgentChat from "~/components/AgentChat.astro";
import { DEMO_AGENTS_META, DEMO_MAX_TURNS_PER_SESSION } from "~/lib/agents-meta";
import { absoluteUrl, localizedPath } from "~/lib/site";
import { breadcrumb } from "~/lib/schema";

export function getStaticPaths() {
  return DEMO_AGENTS_META.map((agent) => ({
    params: { agent: agent.slug },
    props: { agent },
  }));
}

const locale = "fr" as const;
const { agent } = Astro.props;
const link = (p: string) => localizedPath(locale, p);

const title = `${agent.name} — Démo agent · Banana Navy`;
const description = agent.tagline;

const schema = [
  breadcrumb([
    { name: "Banana Navy", url: absoluteUrl("/") },
    { name: "Démo", url: absoluteUrl(link("/demo-agents/")) },
    { name: agent.name, url: absoluteUrl(link(`/demo-agents/${agent.slug}/`)) },
  ]),
];
---
<Base locale={locale} title={title} description={description} schema={schema}>
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <p class="body-s" style="margin-bottom: 24px;">
        <a href={link("/demo-agents/")}>← Tous les agents de démo</a>
      </p>
      <AgentChat
        endpoint="/api/agents/demo"
        agentSlug={agent.slug}
        agentName={agent.name}
        agentTagline={agent.tagline}
        isDemo={true}
        maxTurns={DEMO_MAX_TURNS_PER_SESSION}
      />
    </div>
  </section>
</Base>
